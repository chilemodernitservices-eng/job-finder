# Generate a long random string for AUTH_SECRET and choose a strong APP_PASSWORD.
APP_PASSWORD=
AUTH_SECRET=
CRON_SECRET=
WORKER_RUN_ON_START=false

# Persistence; keep this directory on a persistent local/VPS disk.
DATABASE_PATH=./data/app.db
CV_DIR=./data/cvs
APP_URL=http://localhost:3000

# Structured CV parsing, job review, and cover-letter generation.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODEL_CV=
OPENROUTER_MODEL_CHEAP=
OPENROUTER_MODEL_WRITING=
OPENROUTER_FALLBACK_MODEL=

# Optional direct AI providers; choose one in Profile & Settings.
OPENAI_API_KEY=
OPENAI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Broad Google-indexed web discovery (SearchApi.io currently offers 100 trial searches).
SEARCHAPI_API_KEY=
# Optional direct search of recent X posts; requires an X developer app and bearer token.
X_BEARER_TOKEN=

# Optional SMTP email applications. Sending still requires a human approval.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
